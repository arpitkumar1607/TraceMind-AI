{
  "title": "TraceMind AI — CrewAI & Google ADK Agent Observability, Evaluation & Cost",
  "uid": "tracemind-ai-observability",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Agent Pipeline Pass Rate (%)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "tracemind_agent_eval_pass_rate", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Incidents Processed",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "tracemind_incidents_total", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Estimated Total LLM Cost (USD)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "tracemind_estimated_cost_usd", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg Agent Latency (ms)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "tracemind_agent_latency_ms_avg", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Microservice CPU Utilization (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "tracemind_service_cpu_percent", "legendFormat": "{{service}}", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Microservice Response Latency (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "tracemind_service_latency_ms", "legendFormat": "{{service}}", "refId": "A" }]
    }
  ]
}
