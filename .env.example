# TraceMind AI Environment Configuration

# Database Configuration (PostgreSQL)
POSTGRES_USER=tracemind
POSTGRES_PASSWORD=tracemind123
POSTGRES_DB=tracemind_db
DATABASE_URL=postgresql://tracemind:tracemind123@localhost:5432/tracemind_db

# Optional Groq LLM Configuration
